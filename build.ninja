rule go_build
  command = go build -o $out $pkg
  description = GO BUILD $out

rule gen_dyndep
  command = go run utils/build_dd.go $pkg $out
  description = GEN_DYNDEP $out

build bin/discovery.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/discovery

build bin/discovery: go_build cmd/discovery/main.go || bin/discovery.dd
  pkg = ./cmd/discovery
  dyndep = bin/discovery.dd

build bin/distribute.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/distribute

build bin/distribute: go_build cmd/distribute/main.go || bin/distribute.dd
  pkg = ./cmd/distribute
  dyndep = bin/distribute.dd

build bin/files.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/files

build bin/files: go_build cmd/files/main.go || bin/files.dd
  pkg = ./cmd/files
  dyndep = bin/files.dd

build bin/finder.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/finder

build bin/finder: go_build cmd/finder/main.go || bin/finder.dd
  pkg = ./cmd/finder
  dyndep = bin/finder.dd

build bin/invariant.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/invariant

build bin/invariant: go_build cmd/invariant/upload.go cmd/invariant/main.go cmd/invariant/scan_repo.go cmd/invariant/status.go cmd/invariant/slot.go cmd/invariant/batching_storage.go cmd/invariant/sys_darwin.go cmd/invariant/workspace_pull.go cmd/invariant/print.go cmd/invariant/start.go cmd/invariant/lookup.go cmd/invariant/name.go cmd/invariant/upload_progress.go cmd/invariant/commonmount.go cmd/invariant/systemd.go cmd/invariant/nfs.go cmd/invariant/workspace.go cmd/invariant/sys_other.go cmd/invariant/mount.go cmd/invariant/sys_linux.go || bin/invariant.dd
  pkg = ./cmd/invariant
  dyndep = bin/invariant.dd

build bin/kv.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/kv

build bin/kv: go_build cmd/kv/main.go || bin/kv.dd
  pkg = ./cmd/kv
  dyndep = bin/kv.dd

build bin/names.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/names

build bin/names: go_build cmd/names/main.go || bin/names.dd
  pkg = ./cmd/names
  dyndep = bin/names.dd

build bin/slots.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/slots

build bin/slots: go_build cmd/slots/main.go || bin/slots.dd
  pkg = ./cmd/slots
  dyndep = bin/slots.dd

build bin/storage.dd: gen_dyndep | utils/build_dd.go
  pkg = ./cmd/storage

build bin/storage: go_build cmd/storage/main.go || bin/storage.dd
  pkg = ./cmd/storage
  dyndep = bin/storage.dd

default bin/discovery bin/distribute bin/files bin/finder bin/invariant bin/kv bin/names bin/slots bin/storage
